# Variables de entorno para el envío de correo con SendGrid
#SENDGRID_API_KEY=tu_sendgrid_api_key
#SENDGRID_TO_EMAIL=nolanuv61@gmail.com
#SENDGRID_FROM_EMAIL="Dynamic Data <no-reply@tudominio.com>"

# Alternativa SMTP (opcional): si configuras SMTP, el servicio usará estas variables
HOST_EMAIL=smtp.resend.com
PORT_EMAIL=465
USER_EMAIL=resend
PASS_EMAIL=tu_contraseña_de_resend
SECURE_EMAIL=true
REQUIRE_TLS_EMAIL=true
EMAIL_REJECT_UNAUTHORIZED=true
EMAIL_FROM="Dynamic Data <notify-noreply@dynamicdata.tech>"

# Usa SENDGRID_TO_EMAIL o EMAIL_TO para definir el destinatario final.
EMAIL_TO=nolanuv61@gmail.com
